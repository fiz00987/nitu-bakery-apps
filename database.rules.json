{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "widgetFeed": {
      ".read": true,
      ".write": "auth != null"
    },

    "dcConfig": {
      ".read": true,
      ".write": "auth != null"
    },

    "offDays": {
      ".read": true,
      ".write": "auth != null"
    },

    "dayBooks": {
      ".read": true,
      ".write": "auth != null",
      "$day": {
        ".validate": "newData.hasChildren()",
        "booked": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean()"
        }
      }
    },

    "orders": {
      ".indexOn": ["customerPhone", "orderId", "status", "date"]
    }
  }
}
